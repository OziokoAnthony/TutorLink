APP_ENV=development
# Required, 32+ chars; the app refuses this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_minimum_32_character_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/tutorlink_db
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/tutorlink_db

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Paystack signs webhooks (HMAC-SHA512) with your secret key: set this to the same value as PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bank for parents' dedicated account numbers: test-bank in test mode, e.g. titan-paystack live.
PAYSTACK_DVA_BANK=test-bank

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@tutorlink.ng

# Google sign-in: the OAuth Client ID (Google Cloud console > APIs & Services > Credentials).
# The frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID must be the same value.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Dojah NIN verification with selfie (dashboard > Developers > Configuration). The sandbox test NIN is 70123456789.
# Switch DOJAH_BASE_URL to https://api.dojah.io with live keys.
DOJAH_APP_ID=your_dojah_app_id
DOJAH_SECRET_KEY=your_dojah_secret_key
DOJAH_BASE_URL=https://sandbox.dojah.io

# Claude writes and double-checks the qualifying exam's questions (console.anthropic.com > API keys).
# Without a key the question bank isn't topped up and tutors see "Your exam is being prepared".
ANTHROPIC_API_KEY=your_anthropic_api_key
EXAM_MODEL=claude-opus-5-5

# A private S3-compatible bucket for uploaded files (pictures, certificates, recordings). Leave empty in
# development: files go to LOCAL_STORAGE_DIR.
# Backblaze B2: the bucket's "Endpoint" with https:// in front, and the region is its middle part, e.g.
#   STORAGE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com  STORAGE_REGION=us-west-004
# The key ID and application key come from B2's Application Keys page.
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com with region auto.
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
LOCAL_STORAGE_DIR=storage

# Time-based jobs (expiries, due payments, payable earnings) run inside the API process.
RUN_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=60
