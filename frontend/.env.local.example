NEXT_PUBLIC_API_URL=http://localhost:8000/v1
# Free hosting addresses (no shared domain): NEXT_PUBLIC_API_URL=/api/v1 and API_PROXY_TARGET set to the API's
# address, e.g. https://tutorlink-api.onrender.com. The site then forwards /api/v1 there. Leave empty locally.
API_PROXY_TARGET=
# Google sign-in: the same OAuth Client ID as the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
